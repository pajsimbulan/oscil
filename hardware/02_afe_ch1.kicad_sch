	(text "Compensation: adjust C5 so R4*C5 = R5*C6.\nTune with 1kHz square wave: flat top = correct,\nsagging = undercomp, overshoot = overcomp."
		(exclude_from_sim no)
		(at 90.678 66.802 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
		(uuid "4a0e5f54-bd45-49db-9891-5d01cbf4909f")
	)
	(text "Single-ended, NOT isolated. Shell = system GND = USB GND = mains earth.\nMax +/-5V direct, +/-50V with 10x probe. NEVER connect to mains."
		(exclude_from_sim no)
		(at 38.1 53.848 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
		(uuid "afd41fee-7f3b-4087-805c-fc8595cf257a")
	)
	(text "R3/R4 values are NOMINAL. Measure the actual pair on the DMM\nand store the measured ratio as a calibration constant in\nfirmware (oscil_cal.h). Ratio sets gain; sum sets input Z.\nAbsolute value does not matter, matching does."
		(exclude_from_sim no)
		(at 66.294 79.502 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
