# ESP-IDF build output, one build/ per project
firmware/**/build/
firmware/**/managed_components/

# Generated from sdkconfig.defaults. Commit the defaults, never this.
firmware/**/sdkconfig
firmware/**/sdkconfig.old

# Editors and OS
.history/
.vscode/
Thumbs.db
desktop.ini
.DS_Store

# Generated PC test build
/build-host/

firmware/display/main/secrets.h

# Python
__pycache__/
*.pyc
.venv/

# Local credentials
.env
.env.*
!.env.example
# Raw phone media (HEIC/MOV, hundreds of MB). Web-sized copies are committed instead.
screenshots_and_videos/*.HEIC
screenshots_and_videos/*.MOV
